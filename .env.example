# PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/jolly_tailor
DB_USERNAME=jolly_app
DB_PASSWORD=

# Seeded on first run only if a matching username is not already present
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TAILOR_USERNAME=tailor
BOOTSTRAP_TAILOR_PASSWORD=

# Supabase Storage S3 credentials. Create a bucket for PUBLIC CATALOG IMAGES only.
# Endpoint example: https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PROJECT_URL=
SUPABASE_PUBLIC_BUCKET=tailor-catalog
